{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Multi Screen Recorder",
  "version": "1.0.0",
  "identifier": "com.multiscreenrecorder.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Multi Screen Recorder",
        "width": 980,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "center": true,
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "resources": ["binaries/ffmpeg.exe"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
